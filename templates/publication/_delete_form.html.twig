{# Formulaire permettant de supprimer une publication #}
<form
	method="post" action="{{ path('app_publication_delete', {'id': publication.id}) }}" onsubmit="return confirm('Voulez-vous vraiment supprimer cette publication ?');">

	{# Token de sécurité vérifié par le contrôleur avant la suppression #}
	<input type="hidden" name="_token" value="{{ csrf_token('delete' ~ publication.id) }}">

	<button class="btn">
		Supprimer
	</button>

</form>
