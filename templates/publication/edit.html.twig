{% extends 'base.html.twig' %}

{% block title %}
	Modifier la publication
{% endblock %}

{% block body %}

	<h1>Modifier la publication</h1>

	{# Réutilisation du formulaire commun avec un libellé adapté a la modification #}
	{{ include('publication/_form.html.twig', {
        'button_label': 'Enregistrer les modifications'
    }) }}

	{# Retour vers la liste des publications #}
	<a href="{{ path('app_publication_index') }}">
		Retour à la liste
	</a>

	{# Le bouton supprimer est affiché uniquement a l'auteur de la publication #}
	{% if app.user == publication.auteur %}

		{{ include('publication/_delete_form.html.twig') }}

	{% endif %}

{% endblock %}
