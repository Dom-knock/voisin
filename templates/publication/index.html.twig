{% extends 'base.html.twig' %}

{% block title %}
	Publications
{% endblock %}

{% block body %}

	<h1>Publications</h1>

	{# Accès au formulaire permettant de créer une nouvelle publication #}
	<p>
		<a class="bouton" href="{{ path('app_publication_new') }}">
			Créer une publication
		</a>
	</p>

	{# Parcours des publications envoyées par le controleur #}
	{% for publication in publications %}

		<article
			class="publication">

			{# Accès au pseudo grâce à la relation publication -> user #}
			<h2>
				{{ publication.auteur.pseudo }}
			</h2>

			<p>
				{{ publication.texte }}
			</p>

			{# L'image est affichée uniquement si la publication en possède une #}
			{% if publication.image %}

				<img src="{{ asset('uploads/publications/' ~ publication.image) }}" alt="Image de la publication" class="image-publication">

			{% endif %}

			<p>
				{# capitalize met la première lettre de la visibilité en majuscule #}
				{{ publication.visibilite|capitalize }}

				<br>

				{{ publication.datePublication|date('d/m/Y à H:i') }}
			</p>

			<p>
				{# L'id permet d'accéder à la publication sélectionnée #}
				<a href="{{ path('app_publication_show', {'id': publication.id}) }}">
					Voir
				</a>

				{# Seul l'auteur voit le lien permettant de modifier sa publication #}
				{% if app.user == publication.auteur %}

					|
					<a href="{{ path('app_publication_edit', {'id': publication.id}) }}">
						Modifier
					</a>

				{% endif %}
			</p>

		</article>

	{% else %}

		<p>Aucune publication.</p>

	{% endfor %}

{% endblock %}
