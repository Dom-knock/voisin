{% extends 'base.html.twig' %}

{% block title %}
	Amis
{% endblock %}

{% block body %}

	{# ==========================
		   DEMANDES D'AMITIE RECUES
		   ========================== #}

	<h1>Mes demandes d'amitié reçues</h1>

	{% if demandesRecues is empty %}

		<p>Aucune demande d'amitié en attente.</p>

	{% else %}

		{# Parcours des demandes recues encore en attente #}
		{% for demande in demandesRecues %}

			<article
				class="utilisateur">

				{# Accès au demandeur grace a la relation avec user #}
				<h2>{{ demande.demandeur.pseudo }}</h2>

				{% if demande.demandeur.photo %}
					<img src="{{ asset('uploads/profils/' ~ demande.demandeur.photo) }}" alt="Photo de profil" class="photo-utilisateur">
				{% endif %}

				<p>
					Demande envoyée le
					{{ demande.dateDemande|date('d/m/Y à H:i') }}
				</p>

				{# L'id de la demande permet au controleur de savoir laquelle accepter #}
				<a class="bouton" href="{{ path('app_amis_accepter', {'id': demande.id}) }}">
					Accepter
				</a>

				{# Meme principe pour refuser la demande #}
				<a class="bouton bouton-danger" href="{{ path('app_amis_refuser', {'id': demande.id}) }}">
					Refuser
				</a>

			</article>

		{% endfor %}

	{% endif %}


	{# ==========================
		   LISTE DES AMIS
		   ========================== #}

	<h2>Mes amis</h2>

	{% if amis is empty %}

		<p>Vous n'avez pas encore d'amis.</p>

	{% else %}

		{% for ami in amis %}

			<article class="utilisateur">

				<h2>{{ ami.pseudo }}</h2>

				{% if ami.photo %}
					<img src="{{ asset('uploads/profils/' ~ ami.photo) }}" alt="Photo de profil" class="photo-utilisateur">
				{% endif %}

				{# La biographie est facultative #}
				{% if ami.biographie %}
					<p>{{ ami.biographie }}</p>
				{% endif %}

			</article>

		{% endfor %}

	{% endif %}


	{# ==========================
		   UTILISATEURS A AJOUTER
		   ========================== #}

	<h2>Utilisateurs</h2>

	{% for utilisateur in utilisateurs %}

		{# On retire de la liste
				   l'utilisateur connecté,
				   ses amis,
				   et les utilisateurs ayant deja une demande en attente #}
		{% if utilisateur.id != utilisateurConnecte.id
			and utilisateur.id not in idsAmis
			and utilisateur.id not in idsDemandesEnAttente %}

			<article class="utilisateur">

				<h3>{{ utilisateur.pseudo }}</h3>

				{% if utilisateur.photo %}
					<img src="{{ asset('uploads/profils/' ~ utilisateur.photo) }}" alt="Photo de {{ utilisateur.pseudo }}" class="photo-utilisateur">
				{% endif %}

				{% if utilisateur.biographie %}
					<p>{{ utilisateur.biographie }}</p>
				{% endif %}

				<p>
					{# L'id permet d'indiquer quel utilisateur ajouter en ami #}
					<a class="bouton" href="{{ path('app_amis_ajouter', {'id': utilisateur.id}) }}">
						Ajouter en ami
					</a>
				</p>

			</article>

		{% endif %}

	{% endfor %}

{% endblock %}
