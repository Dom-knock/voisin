{% extends 'base.html.twig' %}

{% block title %}
	Fil d'actualité
{% endblock %}

{% block body %}

	<h1>Fil d'actualité</h1>

	{# Filtres envoyés au controleur par l'URL #}
	<nav>
		<a href="{{ path('app_fil_actualite') }}">
			Toutes
		</a>

		<a href="{{ path('app_fil_actualite', {'filtre': 'publiques'}) }}">
			Publiques uniquement
		</a>

		<a href="{{ path('app_fil_actualite', {'filtre': 'amis'}) }}">
			Amis uniquement
		</a>
	</nav>

	{# Parcours des publications sélectionnés par le controleur #}
	{% for publication in publications %}

		<article
			class="publication">

			{# Affichage du pseudo de l'auteur grace a la relation avec user #}
			<h2>{{ publication.auteur.pseudo }}</h2>

			<p>{{ publication.texte }}</p>

			{# L'image est affichée uniquement si la publication en possède une #}
			{% if publication.image %}
				<img src="{{ asset('uploads/publications/' ~ publication.image) }}" alt="Image de publication" class="image-publication">
			{% endif %}

			<p>
				Publié le
				{{ publication.datePublication|date('d/m/Y à H:i') }}
			</p>

		</article>

		{# Si la collection publications est vide #}
	{% else %}

		<p>Aucune publication visible.</p>

	{% endfor %}

{% endblock %}
