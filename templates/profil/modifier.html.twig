{% extends 'base.html.twig' %}

{% block title %}
	Modifier mon profil
{% endblock %}

{% block body %}

	<h1>Modifier mon profil</h1>

	{# Debut du formulaire créé a partir de ProfilType #}
	{{ form_start(form) }}

	{# Affichage des différents champs du formulaire #}
	{{ form_row(form.pseudo) }}

	{{ form_row(form.photo) }}

	{{ form_row(form.biographie) }}

	<button type="submit">
		Enregistrer
	</button>

	{# Fin du formulaire #}
	{{ form_end(form) }}

	{# Retour vers le profil de l'utilisateur connecté #}
	<a href="{{ path('app_profil', {'id': app.user.id}) }}">
		Retour à mon profil
	</a>

{% endblock %}
